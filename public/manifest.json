{
  "manifest_version": 3,
  "name": "Still Harbor",
  "version": "0.3.1",
  "description": "A quiet boundary for your browsing. Local website blocking and mindful, domain-only insights.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage", "tabs", "idle", "alarms", "webNavigation", "declarativeNetRequest", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Still Harbor", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "options_ui": { "page": "dashboard.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start" }],
  "web_accessible_resources": [{ "resources": ["page.html", "page.js", "styles.css"], "matches": ["http://*/*", "https://*/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
